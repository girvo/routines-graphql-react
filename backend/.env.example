# Environment variables
NODE_ENV=development
JWT_SECRET=
SQLITE_DB=../db/routines.sqlite
# Generate with: pnpm --filter @my-routines/backend vapid:keys
# Leave unset to run without push notifications (the app still serves fine).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@routines.local
